{
    "name": "social-blocker-v6",
    "productName": "Social Blocker v6",
    "version": "1.0.0",
    "description": "A desktop social media blocker built with Electron.",
    "main": "main.js",
    "scripts": {
      "start": "electron .",
      "build": "electron-builder"
    },
    "author": "Joe Kagumba",
    "license": "MIT",
    "devDependencies": {
      "electron": "^29.1.5",
      "electron-builder": "^24.13.3"
    },
    "dependencies": {
      "active-win": "^8.1.0",
      "electron-store": "^8.2.0",
      "sudo-prompt": "^9.2.1"
    },
  "build": {
    "appId": "com.yourname.socialblockerv6",
    "files": [
      "**/*",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
  }
  
  